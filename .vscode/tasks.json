{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start portfolio dev server",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "dev", "--", "--host", "127.0.0.1"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": [{ "regexp": ".*", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE v.*",
          "endsPattern": ".*http://localhost:5173/.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
